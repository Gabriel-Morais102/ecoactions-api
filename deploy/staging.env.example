# Ambiente de homologação. Copie para staging.env e substitua as senhas.
# Use aspas simples em senhas com $ ou #; consulte o .env.example.
COMPOSE_PROJECT_NAME=ecoactions-staging
APP_IMAGE=ecoactions-api:local
APP_PORT=8081
SERVER_PORT=8080

MONGO_PORT=27018
MONGO_DATABASE=ecoactions_staging
MONGO_ROOT_USERNAME=ecoactions_staging
MONGO_ROOT_PASSWORD=staging_mongo_change_me
MONGO_APP_USERNAME=ecoactions_staging_app
MONGO_APP_PASSWORD=staging_mongo_app_change_me
MONGODB_AUTO_INDEX_CREATION=true

APP_ADMIN_USERNAME=admin_staging
APP_ADMIN_PASSWORD=staging_admin_change_me
APP_USER_USERNAME=user_staging
APP_USER_PASSWORD=staging_user_change_me
