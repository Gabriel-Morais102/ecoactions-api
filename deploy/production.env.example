# Ambiente de produção. Copie para production.env e substitua as senhas.
COMPOSE_PROJECT_NAME=ecoactions-production
APP_IMAGE=ecoactions-api:local
APP_PORT=8082
SERVER_PORT=8080

MONGO_PORT=27019
MONGO_DATABASE=ecoactions_production
MONGO_ROOT_USERNAME=ecoactions_production
MONGO_ROOT_PASSWORD=production_mongo_change_me
MONGODB_AUTO_INDEX_CREATION=true

APP_ADMIN_USERNAME=admin_production
APP_ADMIN_PASSWORD=production_admin_change_me
APP_USER_USERNAME=user_production
APP_USER_PASSWORD=production_user_change_me
