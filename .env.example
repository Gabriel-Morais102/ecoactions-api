# Copie este arquivo para .env antes de executar o Docker Compose.
# Substitua todas as senhas de exemplo. O arquivo .env não deve ser versionado.

# Identificação e portas do ambiente
COMPOSE_PROJECT_NAME=ecoactions-local
APP_IMAGE=ecoactions-api:local
APP_PORT=8080
SERVER_PORT=8080

# MongoDB
MONGO_PORT=27017
MONGO_DATABASE=ecoactions
MONGO_ROOT_USERNAME=ecoactions_admin
MONGO_ROOT_PASSWORD=troque_esta_senha
MONGODB_AUTO_INDEX_CREATION=true

# Usuários HTTP Basic da API
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=troque_a_senha_admin
APP_USER_USERNAME=user
APP_USER_PASSWORD=troque_a_senha_user
